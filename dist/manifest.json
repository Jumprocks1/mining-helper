{
  "name": "Anki Mining Helper",
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "version": "1.0",
  "manifest_version": 3,
  "action": {},
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "https://receptomanijalogi.web.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jpdb.io/*"
      ],
      "js": [
        "js/jpdb-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}