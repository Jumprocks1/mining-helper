{
  "name": "Anki Mining Helper",
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "version": "0.0.1",
  "manifest_version": 3,
  "action": {},
  "browser_specific_settings": {
    "gecko": {
      "id": "5703f760-ce2d-42cc-b24f-7c1392fe4397",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "https://receptomanijalogi.web.app/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jpdb.io/*"
      ],
      "js": [
        "js/jpdb-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}