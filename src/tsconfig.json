{
    "compilerOptions": {
        "noEmit": true,
        "target": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "jsx": "react",
        "jsxFactory": "createElement",
        "jsxFragmentFactory": "createFragment",
        "noImplicitOverride": true,
        "types": [
            "chrome"
        ]
    }
}